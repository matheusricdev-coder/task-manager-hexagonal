# Use the root user locally so Prisma can create its shadow database during
# `prisma migrate dev`. The unprivileged `app` user can't CREATE DATABASE.
# Switch to the `app` user in production and supply a SHADOW_DATABASE_URL there.
DATABASE_URL="mysql://root:rootpassword@localhost:3306/task_manager"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
PORT=3000
BCRYPT_SALT_ROUNDS=10
